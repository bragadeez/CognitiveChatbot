# ── Groq ─────────────────────────────────────────────────────────────────────
API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase (optional — app works without these) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=tts-audio

# ── ML Model Paths (pre-configured for this directory layout) ─────────────────
SVM_MODEL_PATH=./models/svm_LS_model.pkl
SVM_SCALER_PATH=./models/svm_scaler.pkl
VECTORSTORE_PATH=./vectorstore

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ── TTS ───────────────────────────────────────────────────────────────────────
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
